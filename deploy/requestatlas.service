# Instalação nativa (mesma máquina/LXC do NPM). Ajuste caminhos e usuário.
[Unit]
Description=RequestAtlas - painel de análise dos logs do Nginx Proxy Manager
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/requestatlas
Environment=REQUESTATLAS_CONFIG=/etc/requestatlas/requestatlas.toml
ExecStart=/usr/bin/python3 -m requestatlas serve
Restart=always
RestartSec=5
Nice=10
IOSchedulingClass=idle
MemoryMax=700M

[Install]
WantedBy=multi-user.target
